# CYBERAURA configuration — copy to `.env` and adjust.
# Real environment variables always override these values.
# No API key is required: without one, the local rule-based interpreter runs
# and every result is honestly labelled as a simulated analysis.

# --- Server -----------------------------------------------------------------
CYBERAURA_HOST=127.0.0.1
PORT=5000
# Set to 1 only for local development (enables the debugger / auto-reload).
CYBERAURA_DEBUG=0

# --- Security ---------------------------------------------------------------
# Optional. If unset, a random key is generated once and stored in instance/secret_key.
# Set a strong, stable value in production so sessions survive restarts.
# CYBERAURA_SECRET_KEY=change-me-to-a-long-random-string
# Set to 1 when serving over HTTPS so the session cookie is Secure-only.
CYBERAURA_SECURE_COOKIE=0

# --- Storage ----------------------------------------------------------------
# Optional. Defaults to instance/cyberaura.sqlite3 (non-sensitive records only).
# CYBERAURA_DATABASE=instance/cyberaura.sqlite3

# --- Optional AI engine -----------------------------------------------------
# Leave the key blank to use the transparent rule-based fallback (recommended for
# the demo). When a key is present, incident text is sent to this OpenAI-compatible
# endpoint. Never commit a real key. Evidence files are NEVER sent to any AI service.
CYBERAURA_AI_API_KEY=
CYBERAURA_AI_API_URL=https://api.openai.com/v1/chat/completions
CYBERAURA_AI_MODEL=gpt-4o-mini